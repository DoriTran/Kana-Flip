{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kanaflip",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "alicenook.me/kanaflip*",
      "zone_name": "alicenook.me"
    }
  ]
}
